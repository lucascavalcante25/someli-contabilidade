# Copie para deploy/contabo/.env na VPS (NUNCA commite o .env real).

# Postgres local (container db)
POSTGRES_PASSWORD=troque-esta-senha-forte

# JWT — copie do Render (obrigatório; tokens antigos quebram se mudar depois do go-live)
JWT_SECRET=

# NFS-e automática pelo Portal Nacional (docs/NFSE_ADN.md)
# Chave que cifra os certificados A1 guardados: gere com `openssl rand -base64 32`.
# Guarde uma cópia fora da VPS. Se for perdida ou trocada, todos os certificados precisam ser reenviados.
CERTIFICADO_CHAVE_MESTRA=
# Busca de hora em hora (true depois de testar com um cliente pelo botão "Buscar agora")
NFSE_ADN_AGENDAMENTO=false

# CORS (front na Vercel)
ALLOWED_ORIGINS=https://someli-contabilidade.vercel.app

# Migração Supabase (só para migrate-from-supabase.sh; pode remover depois)
SUPABASE_HOST=aws-1-us-east-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.eeortzijalyvffwdyats
SUPABASE_DB_PASSWORD=
